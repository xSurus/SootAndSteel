
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

/reference:..\PipelineReferences\MonoGame.Extended.Content.Pipeline.dll

#---------------------------------- Content ---------------------------------#

#begin Data/example.json
/copy:Data/example.json

#begin Data/gameplay.json
/copy:Data/gameplay.json

#begin placeholder_main_menu_background.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:placeholder_main_menu_background.png

#begin promptfont.ttf
/copy:promptfont.ttf

#begin Data/ComponentConfig.json
/copy:Data/ComponentConfig.json

#begin Data/StationConfig.json
/copy:Data/StationConfig.json

