<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>ButtonWithIcon</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="Affordability" Name="AffordabilityState" SetsValue="true" />
    <Variable Type="float" Name="ContainerInstance.Height" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="ContainerInstance.HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
    <Variable Type="float" Name="ContainerInstance.Width" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="ContainerInstance.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
    <Variable Type="float" Name="Height" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
    <Variable Type="float" Name="SpriteInstance.Height" SetsValue="true">
      <Value xsi:type="xsd:float">32</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="SpriteInstance.HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="string" Name="SpriteInstance.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">ContainerInstance</Value>
    </Variable>
    <Variable IsFile="true" Type="string" Name="SpriteInstance.SourceFile" ExposedAsName="ButtonIcon" SetsValue="true">
      <Value xsi:type="xsd:string">spr_coin_32.png</Value>
    </Variable>
    <Variable Type="float" Name="SpriteInstance.Width" SetsValue="true">
      <Value xsi:type="xsd:float">32</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="SpriteInstance.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="float" Name="SpriteInstance.X" SetsValue="true">
      <Value xsi:type="xsd:float">10</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="SpriteInstance.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="SpriteInstance.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">7</Value>
    </Variable>
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="false">
      <Value xsi:type="xsd:string">Default</Value>
    </Variable>
    <Variable Type="int" Name="TextInstance.Blue" ExposedAsName="TextInstanceBlue" SetsValue="false" />
    <Variable IsFont="true" Type="string" Name="TextInstance.Font" SetsValue="true">
      <Value xsi:type="xsd:string">Bodoni MT</Value>
    </Variable>
    <Variable Type="int" Name="TextInstance.FontSize" SetsValue="true">
      <Value xsi:type="xsd:int">20</Value>
    </Variable>
    <Variable Type="int" Name="TextInstance.Green" ExposedAsName="TextInstanceGreen" SetsValue="false" />
    <Variable Type="HorizontalAlignment" Name="TextInstance.HorizontalAlignment" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="string" Name="TextInstance.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">ContainerInstance</Value>
    </Variable>
    <Variable Type="int" Name="TextInstance.Red" ExposedAsName="TextInstanceRed" SetsValue="false" />
    <Variable Type="string" Name="TextInstance.Text" ExposedAsName="ButtonText" SetsValue="true">
      <Value xsi:type="xsd:string">Credits</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="TextInstance.VerticalAlignment" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="TextInstance.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="float" Name="TextInstance.X" SetsValue="true">
      <Value xsi:type="xsd:float">50</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="TextInstance.XOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="TextInstance.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="float" Name="Width" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
  </State>
  <Category>
    <Name>Affordability</Name>
    <State>
      <Name>canAfford</Name>
      <Variable Type="int" Name="TextInstance.Blue" Category="Rendering" SetsValue="true">
        <Value xsi:type="xsd:int">255</Value>
      </Variable>
      <Variable Type="int" Name="TextInstance.Green" Category="Rendering" SetsValue="true">
        <Value xsi:type="xsd:int">255</Value>
      </Variable>
      <Variable Type="int" Name="TextInstance.Red" Category="Rendering" SetsValue="true">
        <Value xsi:type="xsd:int">255</Value>
      </Variable>
    </State>
    <State>
      <Name>cantAfford</Name>
      <Variable Type="int" Name="TextInstance.Blue" SetsValue="true">
        <Value xsi:type="xsd:int">82</Value>
      </Variable>
      <Variable Type="int" Name="TextInstance.Green" SetsValue="true">
        <Value xsi:type="xsd:int">82</Value>
      </Variable>
      <Variable Type="int" Name="TextInstance.Red" SetsValue="true">
        <Value xsi:type="xsd:int">253</Value>
      </Variable>
    </State>
  </Category>
  <Instance Name="TextInstance" BaseType="Text" />
  <Instance Name="ContainerInstance" BaseType="Container" />
  <Instance Name="SpriteInstance" BaseType="Sprite" />
  <Behaviors />
</ComponentSave>