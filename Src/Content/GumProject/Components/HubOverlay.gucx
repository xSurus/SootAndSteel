<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>HubOverlay</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="CurrencyDisplayInstance.X" SetsValue="true">
      <Value xsi:type="xsd:float">-40</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="CurrencyDisplayInstance.XOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="CurrencyDisplayInstance.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
    <Variable Type="float" Name="CurrencyDisplayInstance.Y" SetsValue="true">
      <Value xsi:type="xsd:float">40</Value>
    </Variable>
    <Variable Type="float" Name="Height" SetsValue="true">
      <Value xsi:type="xsd:float">100</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="Ready" Name="PlayersReadyInstance.ReadyState" ExposedAsName="PlayersReadyInstanceReadyState" SetsValue="true">
      <Value xsi:type="xsd:string">notReady</Value>
    </Variable>
    <Variable Type="float" Name="PlayersReadyInstance.Width" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="float" Name="PlayersReadyInstance.X" SetsValue="true">
      <Value xsi:type="xsd:float">-40</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="PlayersReadyInstance.XOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="PlayersReadyInstance.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
    <Variable Type="float" Name="PlayersReadyInstance.Y" SetsValue="true">
      <Value xsi:type="xsd:float">-20</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="PlayersReadyInstance.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="PlayersReadyInstance.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">5</Value>
    </Variable>
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="false">
      <Value xsi:type="xsd:string">Default</Value>
    </Variable>
    <Variable Type="float" Name="Width" SetsValue="true">
      <Value xsi:type="xsd:float">100</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
  </State>
  <Instance Name="PlayersReadyInstance" BaseType="PlayersReady" />
  <Instance Name="CurrencyDisplayInstance" BaseType="CurrencyDisplay" />
  <Behaviors />
</ComponentSave>