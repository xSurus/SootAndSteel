<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>JoinPlayerComponent</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="Height" SetsValue="true">
      <Value xsi:type="xsd:float">100</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">5</Value>
    </Variable>
    <Variable Type="string" Name="Join.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">Player</Value>
    </Variable>
    <Variable Type="float" Name="Join.X" SetsValue="true">
      <Value xsi:type="xsd:float">55</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="Join.XOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="Join.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="float" Name="Join.Y" SetsValue="true">
      <Value xsi:type="xsd:float">110</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="Join.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">3</Value>
    </Variable>
    <Variable Type="Joined" Name="JoinedState" SetsValue="true" />
    <Variable Type="int" Name="JoinText" SetsValue="true" IsCustomVariable="true">
      <Value xsi:type="xsd:int">10</Value>
    </Variable>
    <Variable Type="float" Name="Player.Height" SetsValue="true">
      <Value xsi:type="xsd:float">80</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="Player.HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="float" Name="Player.Width" SetsValue="true">
      <Value xsi:type="xsd:float">80</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="Player.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="float" Name="Player.X" SetsValue="true">
      <Value xsi:type="xsd:float">5</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="Player.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="bool" Name="PlayerFigure.Animate" SetsValue="true">
      <Value xsi:type="xsd:boolean">false</Value>
    </Variable>
    <Variable Type="string" Name="PlayerFigure.CurrentChainName" SetsValue="true">
      <Value xsi:type="xsd:string"></Value>
    </Variable>
    <Variable Type="float" Name="PlayerFigure.Height" SetsValue="true">
      <Value xsi:type="xsd:float">100</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="PlayerFigure.HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="string" Name="PlayerFigure.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">Player</Value>
    </Variable>
    <Variable IsFile="true" Type="string" Name="PlayerFigure.SourceFile" ExposedAsName="SpriteInstanceSourceFile" SetsValue="true">
      <Value xsi:type="xsd:string">IdleA0.png</Value>
    </Variable>
    <Variable Type="TextureAddress" Name="PlayerFigure.TextureAddress" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="int" Name="PlayerFigure.TextureHeight" SetsValue="true">
      <Value xsi:type="xsd:int">400</Value>
    </Variable>
    <Variable Type="int" Name="PlayerFigure.TextureLeft" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="int" Name="PlayerFigure.TextureTop" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="int" Name="PlayerFigure.TextureWidth" SetsValue="true">
      <Value xsi:type="xsd:int">410</Value>
