<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>MainMenuButton</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="Height" SetsValue="true">
      <Value xsi:type="xsd:float">20</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">5</Value>
    </Variable>
    <Variable IsFont="true" Type="string" Name="Lable.Font" SetsValue="true">
      <Value xsi:type="xsd:string">Ubuntu Mono</Value>
    </Variable>
    <Variable Type="int" Name="Lable.FontSize" SetsValue="true">
      <Value xsi:type="xsd:int">30</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="Lable.HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="Lable.HorizontalAlignment" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="string" Name="Lable.Text" ExposedAsName="ButtonText" SetsValue="false" />
    <Variable Type="DimensionUnitType" Name="Lable.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
    <Variable Type="Selection" Name="SelectionState" SetsValue="true" />
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="false">
      <Value xsi:type="xsd:string">Default</Value>
    </Variable>
    <Variable Type="float" Name="Width" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
  </State>
  <Category>
    <Name>Selection</Name>
    <State>
      <Name>Selected</Name>
      <Variable Type="int" Name="Lable.Blue" SetsValue="true">
        <Value xsi:type="xsd:int">138</Value>
      </Variable>
      <Variable Type="int" Name="Lable.Green" SetsValue="true">
        <Value xsi:type="xsd:int">222</Value>
      </Variable>
      <Variable Type="int" Name="Lable.Red" SetsValue="true">
        <Value xsi:type="xsd:int">231</Value>
      </Variable>
    </State>
    <State>
      <Name>Unselected</Name>
      <Variable Type="int" Name="Lable.Blue" Category="Rendering" SetsValue="true">
        <Value xsi:type="xsd:int">255</Value>
      </Variable>
      <Variable Type="int" Name="Lable.Green" Category="Rendering" SetsValue="true">
        <Value xsi:type="xsd:int">255</Value>
      </Variable>
      <Variable Type="int" Name="Lable.Red" Category="Rendering" SetsValue="true">
        <Value xsi:type="xsd:int">255</Value>
      </Variable>
    </State>
  </Category>
  <Instance Name="Lable" BaseType="Text" />
  <Behaviors />
</ComponentSave>