      <Value xsi:type="xsd:int">4</Value>
    </Variable>
  </State>
  <Category>
    <Name>Selected</Name>
    <State>
      <Name>isSelected</Name>
      <Variable IsFile="true" Type="string" Name="SpriteInstance.SourceFile" SetsValue="true">
        <Value xsi:type="xsd:string">spr_chevron_32.png</Value>
      </Variable>
      <Variable Type="int" Name="SpriteInstance.Blue" Category="Rendering" SetsValue="true">
