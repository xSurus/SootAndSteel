      </Variable>
      <Variable Type="int" Name="TextInstance.Blue" Category="Rendering" SetsValue="true">
        <Value xsi:type="xsd:int">24</Value>
      </Variable>
      <Variable Type="int" Name="TextInstance.Green" Category="Rendering" SetsValue="true">
        <Value xsi:type="xsd:int">56</Value>
      </Variable>
      <Variable Type="int" Name="TextInstance.Red" Category="Rendering" SetsValue="true">
        <Value xsi:type="xsd:int">106</Value>
      </Variable>
    </State>
    <State>
      <Name>notSelected</Name>
      <Variable IsFile="true" Type="string" Name="SpriteInstance.SourceFile" SetsValue="true">
        <Value xsi:type="xsd:string">spr_coin_32.png</Value>
      </Variable>
      <Variable Type="bool" Name="SpriteInstance.Visible" SetsValue="true">
        <Value xsi:type="xsd:boolean">false</Value>
      </Variable>
