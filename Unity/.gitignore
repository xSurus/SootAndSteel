# Unity/.gitignore
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
*.csproj
*.sln
*.slnx
*.tmp
.vs/
.vscode/

# Repo-root .gitignore has a bare `*.dll` rule that would otherwise silently
# swallow FMOD's native plugins (fmodstudio.dll etc.) installed under
# Assets/Plugins/. Un-ignore them here so they get committed.
!Assets/Plugins/**/*.dll

# Editor-generated scene template defaults, not project content.
ProjectSettings/SceneTemplateSettings.json
