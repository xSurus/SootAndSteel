<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="Root" class="co-root vignette">
        <ui:VisualElement name="Paper" class="co-paper paper">
            <ui:VisualElement name="Image" class="co-image" />
            <ui:VisualElement name="Close" class="co-close">
                <ui:Label name="CloseKey" text="A" class="co-close-text font-serif" />
                <ui:Label name="CloseText" text="Close" class="co-close-text font-serif" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
