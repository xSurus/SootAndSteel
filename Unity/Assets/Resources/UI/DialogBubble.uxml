<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="Root" class="hub-view db-root hub-fill" picking-mode="Ignore">
        <ui:VisualElement name="Bubble" class="db-bubble">
            <ui:VisualElement name="Shadow" class="db-shadow" />
            <ui:VisualElement name="Parchment" class="db-parchment">
                <ui:VisualElement name="Header" class="db-header">
                    <ui:Label name="Speaker" class="hub-text db-speaker font-mono" />
                </ui:VisualElement>
                <ui:VisualElement name="TextWrapper" class="db-text-wrapper">
                    <ui:Label name="Body" class="hub-text db-body font-typewriter" />
                    <ui:VisualElement name="Footer" class="db-footer">
                        <ui:VisualElement name="Separator" class="db-separator" />
                        <ui:VisualElement name="Interactions" class="db-interactions">
                            <ui:VisualElement name="LeftButton" class="db-left" />
                            <ui:VisualElement name="RightButton" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
