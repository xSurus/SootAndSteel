.pm-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }
.pm-paper { width: 380px; height: 353px; rotate: -1deg; background-size: 100% 100%; }
.pm-title { position: absolute; left: -4px; top: 41px; width: 100%; font-size: 40px; color: rgb(17, 17, 9); -unity-text-align: upper-center; }
.pm-hint { position: absolute; left: 115px; top: 83px; width: 150px; font-size: 11px; color: rgba(0, 0, 0, 0.565); -unity-text-align: upper-center; }
.pm-dashes { position: absolute; left: 0; top: 104px; width: 100%; font-size: 18px; color: rgb(0, 0, 0); -unity-text-align: upper-center; }
/* Container centred at 48.52% x 65.37% of the paper. */
.pm-menu { position: absolute; left: 48.52%; top: 65.37%; translate: -50% -50%; flex-direction: column; align-items: center; }
.pm-row { flex-direction: row; height: 32px; align-items: center; }
.pm-row--0 { translate: 0 0; }
.pm-row--1 { translate: -5px 0; }
.pm-row--2 { translate: 6px 0; }
.pm-row--3 { translate: 0 0; }
.pm-chevron { position: absolute; left: 10px; top: 0; width: 32px; height: 32px; display: none;
    background-image: url("/Assets/Resources/UI/Art/spr_chevron_32.png"); -unity-background-image-tint-color: var(--chevron-tint); }
.pm-row--selected .pm-chevron { display: flex; }
.pm-label { margin-left: 50px; font-size: 20px; color: var(--ink); -unity-text-align: middle-left; }
.pm-row--selected .pm-label { color: var(--label-selected); }
