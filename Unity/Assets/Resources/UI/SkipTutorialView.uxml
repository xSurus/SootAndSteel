<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="Root" class="stv-root" picking-mode="Ignore">
        <ui:VisualElement name="Icon" class="stv-icon" picking-mode="Ignore" />
        <ui:Label name="Text" class="hub-text stv-text font-serif" text="Hold to skip tutorial" />
        <ui:VisualElement name="BarRow" class="stv-barrow" picking-mode="Ignore">
            <ui:VisualElement name="ProgressBar" class="stv-bar" picking-mode="Ignore">
                <ui:VisualElement name="ProgressBarBackground" class="stv-bar-bg" picking-mode="Ignore" />
                <ui:VisualElement name="ProgressBarProgress" class="stv-bar-fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
